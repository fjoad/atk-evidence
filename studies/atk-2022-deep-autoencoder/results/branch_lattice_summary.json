  "exclusions": [
    {
      "id": "full_semantic_cartesian_product",
      "reason": "Arbitrary higher-order combinations are not distinct textual interpretations. Every option and every allowed option pair is covered; coupled blocks are fully crossed and promoted branches receive full treatment."
    },
    {
      "id": "test_label_selected_threshold_as_paper_consistent",
      "reason": "The paper explicitly says its test set differs from validation; test-label selection is retained only as an X-track leakage mechanism demonstration."
    },
    {
      "id": "dot_product_attention_as_paper_consistent",
      "reason": "The paper explicitly describes Gamma as a jointly trained feed-forward neural network; dot attention may be a corrected or X-track control only."
    },
    {
      "id": "undocumented_dataset_subsets",
      "reason": "No finite text-grounded enumeration exists beyond all Code=1 meters and repeated deterministic approximately-3000 subsets."
    },
    {
      "id": "unbounded_backend_version_cartesian",
      "reason": "The paper names Keras but gives no version or backend. The reproduction uses one locked Keras-compatible semantic implementation; version/backend perturbations are X-track sensitivities unless they change a paper-specified graph operation."
    },
    {
      "id": "full_per_layer_width_cartesian_search",
      "reason": "Algorithm 6 explicitly uses a sequential search to avoid exhaustive search. The literal scalar-width and per-layer coordinate interpretations are retained; a 5^L width-vector Cartesian search is not the printed algorithm."
    }
  ],
